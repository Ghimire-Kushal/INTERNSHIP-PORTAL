# Keep this secret only in local environment files. Never commit backend/.env.
SECRET_KEY=generate-a-unique-secret-key-for-your-environment
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL (the intended local database)
DB_NAME=job_portal_db
DB_USER=postgres
DB_PASSWORD=your-postgresql-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Set True only when you need a quick local smoke test without PostgreSQL.
USE_SQLITE=False

# Comma-separated frontend origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
